<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WowWotlk.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="760"
        x:Class="WowWotlk.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Width="1200" Height="800" MinWidth="940" MinHeight="620"
        Title="WotLK Autoinstall">

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,8" Background="{StaticResource FrostPanel}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource FrostHairline}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Log" Padding="12,4"
                        Command="{Binding ToggleLogPaneCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Cancel" Padding="12,4"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsBusy}" Margin="8,0,0,0"/>
                <ProgressBar DockPanel.Dock="Right" Width="200" Height="4"
                             Minimum="0" Maximum="1"
                             Value="{Binding OverallProgress}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}"
                             IsVisible="{Binding IsBusy}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Classes="data" Foreground="{StaticResource FrostMuted}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Log pane. The header names the file on disk and opens it: this pane keeps only the
             last 2000 lines, and a failed multi-hour install is diagnosed from the whole log. -->
        <Border DockPanel.Dock="Bottom" Height="240"
                IsVisible="{Binding LogPaneOpen}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource FrostHairline}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,5"
                        Background="{StaticResource FrostPanel}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource FrostHairline}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="ghost" Content="Open log file"
                                Padding="10,3" Margin="8,0,0,0" Command="{Binding OpenLogFileCommand}"/>
                        <SelectableTextBlock Text="{Binding LogFilePath}" Classes="data"
                                             Foreground="{StaticResource FrostMuted}"
                                             VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <ListBox x:Name="LogList" Classes="log" ItemsSource="{Binding LogLines}"/>
            </DockPanel>
        </Border>

        <!-- Rail -->
        <Border DockPanel.Dock="Left" Width="208" Background="{StaticResource FrostPanel}"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource FrostHairline}">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="19,24,19,20" Spacing="1">
                    <TextBlock Text="WRATH OF THE LICH KING" FontSize="9" LetterSpacing="2"
                               Foreground="{StaticResource FrostMuted}" TextWrapping="Wrap"/>
                    <TextBlock Text="AZEROTH" FontSize="25" FontWeight="Bold" LetterSpacing="5"
                               Foreground="{StaticResource QualityHeirloom}" Margin="0,4,0,0"/>
                    <TextBlock Text="LOCAL CLIENT KIT" FontSize="9" LetterSpacing="3"
                               Foreground="{StaticResource FrostMuted}" Margin="0,4,0,0"/>
                    <Rectangle Height="1" Fill="{StaticResource FrostHairline}" Margin="0,16,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1" Classes="nav" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Classes="nav-icon" Text="{Binding Icon}" Width="16"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Classes="nav-label" Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The client version already sits in every page header; this is the app's. -->
                <TextBlock Grid.Row="2" Margin="19,0,19,18" FontSize="10" TextWrapping="Wrap"
                           Classes="data" Foreground="{StaticResource FrostMuted}"
                           Text="{Binding AppVersion, StringFormat='v{0}'}"/>
            </Grid>
        </Border>

        <!-- Page content -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding SelectedNavItem.Page}" Margin="30,26,30,30"/>
        </ScrollViewer>
    </DockPanel>
</Window>
