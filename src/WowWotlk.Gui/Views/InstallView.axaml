<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WowWotlk.Gui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="900"
             x:Class="WowWotlk.Gui.Views.InstallView"
             x:DataType="vm:InstallViewModel">

    <UserControl.Styles>
        <!-- Phase track. A segment is a label over a 2px rule; the rule carries the state so
             the labels stay one weight and the eye tracks the line, not the text. -->
        <Style Selector="TextBlock.phase">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FrostMuted}"/>
        </Style>
        <Style Selector="TextBlock.phase.active">
            <Setter Property="Foreground" Value="{StaticResource FrostIceBright}"/>
        </Style>
        <Style Selector="TextBlock.phase.done">
            <Setter Property="Foreground" Value="{StaticResource QualityUncommon}"/>
        </Style>
        <Style Selector="Rectangle.rule">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Fill" Value="{StaticResource FrostHairline}"/>
        </Style>
        <Style Selector="Rectangle.rule.active">
            <Setter Property="Fill" Value="{StaticResource FrostIceBright}"/>
        </Style>
        <Style Selector="Rectangle.rule.done">
            <Setter Property="Fill" Value="{StaticResource QualityUncommon}"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FrostText}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="22" MaxWidth="880" HorizontalAlignment="Stretch">

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="WRATH OF THE LICH KING"/>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="data" Text="3.3.5a · 12340"
                           Foreground="{StaticResource QualityHeirloom}" VerticalAlignment="Bottom"/>
                <TextBlock Classes="h1" Text="Install the client"/>
            </DockPanel>
        </StackPanel>

        <!-- Phase track: the page's centre of gravity during a run -->
        <Border Classes="card" Padding="20,18">
            <StackPanel Spacing="16">
                <ItemsControl ItemsSource="{Binding Phases}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhaseSegment">
                            <StackPanel Spacing="7" Margin="0,0,10,0">
                                <TextBlock Classes="phase" Text="{Binding Name}"
                                           Classes.active="{Binding IsActive}"
                                           Classes.done="{Binding IsDone}"/>
                                <Rectangle Classes="rule"
                                           Classes.active="{Binding IsActive}"
                                           Classes.done="{Binding IsDone}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The action sits with the track it drives, at the top of the page: this is
                     one button that does the whole thing, and it should not be findable only
                     by scrolling past every setting it happens to use. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- The counter is the value a user watches for an hour, so it gets the
                             size. The detail line under it names what is moving right now. -->
                        <StackPanel Spacing="3" IsVisible="{Binding IsRunning}">
                            <TextBlock Text="{Binding PhaseCounter}" FontFamily="monospace"
                                       FontSize="30" FontWeight="Light"
                                       Foreground="{StaticResource FrostText}"/>
                            <TextBlock Text="{Binding PhaseDetail}" Classes="data muted"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Minimum="0" Maximum="1" Height="4" Margin="0,7,0,0"
                                         Value="{Binding PhaseFraction}"/>
                        </StackPanel>
                        <StackPanel Spacing="3" IsVisible="{Binding !IsRunning}">
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{Binding PhaseDetail}"/>
                            <TextBlock Classes="data muted" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding InstalledClientRoot, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding InstalledClientRoot, StringFormat='Installed at {0}'}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <Button Classes="accent" Content="INSTALL EVERYTHING" MinWidth="215"
                                Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"/>
                        <TextBlock Classes="muted" FontSize="11" TextAlignment="Center"
                                   Text="Client · realm · addons · Steam"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Source -->
        <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="CLIENT SOURCE"/>
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="26">
                        <RadioButton GroupName="src" Content="Google Drive" IsChecked="{Binding SourceIsDrive}"/>
                        <RadioButton GroupName="src" Content="Zip on disk" IsChecked="{Binding SourceIsZip}"/>
                        <RadioButton GroupName="src" Content="Folder already unpacked" IsChecked="{Binding SourceIsFolder}"/>
                    </StackPanel>

                    <StackPanel Spacing="3" IsVisible="{Binding SourceIsDrive}">
                        <StackPanel Spacing="3" IsVisible="{Binding HasDriveFileId}">
                            <TextBlock Classes="data" Text="{Binding DriveFileId}"
                                       Foreground="{StaticResource FrostText}"/>
                            <TextBlock Classes="data muted" Text="Resumes where it left off if interrupted."/>
                        </StackPanel>
                        <!-- The app ships without a file id: the client zip is the user's own
                             upload, not something this repo can carry. Say where to put it. -->
                        <TextBlock IsVisible="{Binding !HasDriveFileId}" Classes="muted"
                                   TextWrapping="Wrap"
                                   Text="No Google Drive file id set yet. Put the share link's id on the Settings page — it's the long code between /d/ and /view in the link."/>
                    </StackPanel>

                    <DockPanel IsVisible="{Binding SourceIsZip}">
                        <Button DockPanel.Dock="Right" Classes="ghost" Content="Choose zip…"
                                Margin="10,0,0,0" Command="{Binding PickZipCommand}"/>
                        <TextBox Classes="data" Text="{Binding LocalZipPath}"
                                 PlaceholderText="Path to World of Warcraft 3.3.5a.zip"/>
                    </DockPanel>

                    <DockPanel IsVisible="{Binding SourceIsFolder}">
                        <Button DockPanel.Dock="Right" Classes="ghost" Content="Choose folder…"
                                Margin="10,0,0,0" Command="{Binding PickClientFolderCommand}"/>
                        <TextBox Classes="data" Text="{Binding ExistingClientPath}"
                                 PlaceholderText="Folder containing Wow.exe"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Folders -->
        <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="FOLDERS"/>
            <Grid ColumnDefinitions="*,16,*">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="muted" FontSize="12" Text="Install the client to"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="ghost" Content="…"
                                    Padding="12,5" Margin="8,0,0,0"
                                    Command="{Binding PickInstallDirCommand}"/>
                            <TextBox Classes="data" Text="{Binding InstallDir}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" IsEnabled="{Binding SourceIsDrive}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="muted" FontSize="12" Text="Download the zip to"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="ghost" Content="…"
                                    Padding="12,5" Margin="8,0,0,0"
                                    Command="{Binding PickDownloadDirCommand}"/>
                            <TextBox Classes="data" Text="{Binding DownloadDir}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Realm. Labelled with the exact token written to realmlist.wtf, so the field
             teaches what the app does to the client. -->
        <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="REALM"/>
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="data" Text="set realmlist" VerticalAlignment="Center"
                                   Foreground="{StaticResource QualityHeirloom}"/>
                        <TextBox Classes="data" Width="280" Text="{Binding ServerAddress}"
                                 PlaceholderText="127.0.0.1"/>
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Written to every realmlist.wtf the client has. Use 127.0.0.1 for a server on this machine, or the LAN address of the box running it."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Display. Sits with the realm because both write into the client rather than
             describing where it comes from. -->
        <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="DISPLAY"/>
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="Resolution" VerticalAlignment="Center" Width="86"
                                   Classes="muted" FontSize="12"/>
                        <ComboBox Width="260" FontFamily="monospace" FontSize="13"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}"
                                  IsEnabled="{Binding !!Resolutions.Count}"/>
                        <CheckBox Content="Windowed" IsChecked="{Binding Windowed}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding ResolutionNote}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Addons. Shown in full rather than hidden behind a count: this is the one step that
             writes files the user did not individually ask for, so what it will do is on the
             page before they press the button. -->
        <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="ADDONS"/>
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <CheckBox Content="Install addons as part of the install"
                              IsChecked="{Binding InstallAddons}"/>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding AddonSummary}"/>
                    <ItemsControl ItemsSource="{Binding AddonChoices}" IsEnabled="{Binding InstallAddons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AddonChoice">
                                <CheckBox IsChecked="{Binding Selected}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Category}" Classes="muted"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Unticked by default: ElvUI and Dominos both replace the action bars and conflict with each other, Immersion replaces the quest window, and Grid2 is for healing. Questie is off because Zygor covers the same job — tick it instead if you prefer map markers to a step-by-step guide. An addon that can't be fetched is skipped and reported — it never fails the install."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Patches are separate from addons on purpose: they are game data rather than
             interface code, they go into Data/<locale> rather than Interface/AddOns, and
             removing one is deleting a file rather than a folder. -->
        <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="GAME PATCHES"/>
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <CheckBox Content="Install game patches as part of the install"
                              IsChecked="{Binding InstallPatches}"/>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding PatchSummary}"/>
                    <ItemsControl ItemsSource="{Binding PatchChoices}" IsEnabled="{Binding InstallPatches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AddonChoice">
                                <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}"
                                          Margin="0,0,8,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="MPQ files that go into the client's Data folder for its language, so the game engine loads them at startup. A file already using the same name is kept alongside rather than overwritten — two patches cannot share a letter, and the engine would silently load only one."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="STEAM"/>
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <CheckBox Content="Add the client to Steam when the install finishes"
                              IsChecked="{Binding SetupSteamAfterInstall}"/>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Closes and restarts Steam to write the shortcut, then creates the Proton prefix so your first Play goes straight to the login screen."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Preflight -->
        <StackPanel Spacing="10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Re-check" Padding="12,4"
                        Command="{Binding RefreshChecksCommand}"/>
                <TextBlock Classes="section" Text="PREFLIGHT" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Classes="card" Padding="16,10">
                <StackPanel>
                    <TextBlock Classes="muted" Text="Checking…" IsVisible="{Binding IsCheckingPreflight}"
                               Margin="0,6"/>
                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CheckRow">
                                <Grid ColumnDefinitions="26,150,*" Margin="0,7">
                                    <TextBlock Grid.Column="0" Classes="glyph" Text="{Binding Glyph}"
                                               Classes.ok="{Binding IsOk}"
                                               Classes.warn="{Binding IsWarn}"
                                               Classes.fail="{Binding IsFail}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                               Classes="data muted" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom padding so the last card clears the status bar when scrolled to the end. -->
        <Rectangle Height="4" Fill="Transparent"/>
    </StackPanel>
</UserControl>
